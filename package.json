{
  "name": "roadlimit-uae",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first speed-limit awareness for UAE roads.",
  "license": "Apache-2.0",
  "author": "Juber Shaikh and contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeWithJuber/roadlimit-uae.git"
  },
  "homepage": "https://github.com/CodeWithJuber/roadlimit-uae#readme",
  "bugs": {
    "url": "https://github.com/CodeWithJuber/roadlimit-uae/issues"
  },
  "keywords": [
    "expo",
    "react-native",
    "android",
    "ios",
    "road-safety",
    "speed-awareness",
    "uae",
    "dubai",
    "privacy"
  ],
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "expo-doctor",
    "repo:check": "node tools/check-repository.mjs",
    "check:data": "vitest run src/data/__tests__/dubaiRoads.test.ts",
    "data:import": "node tools/import-dubai-csv.mjs",
    "check": "npm run typecheck && npm test && npm run repo:check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.14",
    "expo-constants": "~57.0.12",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-location": "~57.0.11",
    "expo-notifications": "~57.0.12",
    "expo-speech": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.11",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-doctor": "^1.20.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
